<?xml version="1.0" encoding="utf-8"?>
<!--
  CubeOS: the "unlock with your screen lock" sheet that BiometricPrompt shows when an app (Wallet,
  Passwords, Notes, banking apps ...) asks for the device PIN, pattern or password. It is drawn as
  CubeOS's own passcode screen: a full-screen black panel like the lock-screen bouncer, a plain
  Cancel at the top left, a centred header, passcode dots over the bouncer's round frosted keys.
  The panel is dark in light and dark mode alike (as the bouncer and iOS's system passcode sheet
  are), so every colour here is fixed rather than taken from the day/night palette.
-->
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <color name="cube_auth_background">#FF000000</color>
    <color name="cube_auth_label">#FFFFFFFF</color>
    <!-- iOS secondaryLabel / tertiaryLabel on a dark background. -->
    <color name="cube_auth_secondary_label">#99EBEBF5</color>
    <color name="cube_auth_tertiary_label">#4DEBEBF5</color>
    <color name="cube_auth_accent">#FF0A84FF</color>
    <color name="cube_auth_destructive">#FFFF453A</color>
    <color name="cube_auth_field">#FF1C1C1E</color>
    <color name="cube_auth_highlight">#33FFFFFF</color>

    <dimen name="cube_auth_top_bar_height">52dp</dimen>
    <dimen name="cube_auth_header_icon_size">40dp</dimen>
    <!-- The bouncer's key: 78dp round, 24dp apart, rows 16dp apart. -->
    <dimen name="cube_auth_pin_key_size">@dimen/num_pad_key_width</dimen>
    <dimen name="cube_auth_pin_key_gap">@dimen/num_pad_key_margin_end</dimen>
    <dimen name="cube_auth_pin_row_gap">@dimen/num_pad_entry_row_margin_bottom</dimen>
    <dimen name="cube_auth_pin_dot_size">13dp</dimen>
    <dimen name="cube_auth_pin_dot_gap">18dp</dimen>
    <dimen name="cube_auth_pin_dot_ring">1.25dp</dimen>
    <dimen name="cube_auth_pin_dots_height">48dp</dimen>

    <!-- Plain "Cancel" in the iOS accent, top left. -->
    <style name="CubeAuthCancelButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">@*android:string/config_bodyFontFamily</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/cube_auth_accent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:text">@android:string/cancel</item>
    </style>

    <!-- PIN: the real field stays (it holds the PIN for the existing checks and takes hardware
         keyboard input) but is drawn invisibly; CubePinDotsView draws the dots over it. -->
    <style name="CubeAuthPinEntry">
        <item name="android:background">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">1sp</item>
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:textColorHighlight">@android:color/transparent</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:longClickable">false</item>
        <item name="android:textIsSelectable">false</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <!-- The OK key: accent text where iOS puts it on a custom-length numeric code. -->
    <style name="CubeAuthPinOkKey">
        <item name="android:gravity">center</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:fontFamily">@*android:string/config_bodyFontFamilyMedium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/cube_auth_accent</item>
        <item name="android:text">@android:string/ok</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- Pattern: white dots, accent path, red on a wrong pattern. -->
    <style name="CubeAuthLockPatternView">
        <item name="*android:regularColor">@color/cube_auth_accent</item>
        <item name="*android:pathColor">@color/cube_auth_accent</item>
        <item name="*android:successColor">@color/cube_auth_label</item>
        <item name="*android:errorColor">@color/cube_auth_destructive</item>
        <item name="*android:dotColor">@color/cube_auth_label</item>
        <item name="*android:dotActivatedColor">@color/cube_auth_accent</item>
    </style>
</resources>
