<?xml version="1.0" encoding="utf-8"?>
<!--
  CubeOS: the top bar of the "unlock with your screen lock" sheet - a plain Cancel at the top left.
  CredentialViewBinder wires R.id.cancel_button to Host.onCredentialAborted(), the same path the
  back gesture takes (send user-cancelled, animate away).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cube_auth_top_bar_height"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <Button
        android:id="@+id/cancel_button"
        style="@style/CubeAuthCancelButton"
        android:layout_gravity="center_vertical|start" />

</FrameLayout>
