<!-- CubeOS: the PIN sheet as CubeOS's passcode screen - Cancel top left, a centred header, passcode
     dots, then the lock-screen bouncer's round frosted keys (CubePinPadView, the IPinPad that
     CredentialPasswordViewBinder looks up by R.id.pin_pad). No IME is shown for a PIN. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <include layout="@layout/auth_credential_cube_top_bar" />

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
      android:id="@+id/auth_credential_header"
      style="?headerStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingBottom="0dp">

      <ImageView
          android:id="@+id/icon"
          style="?headerIconStyle"
          android:layout_centerHorizontal="true"
          android:layout_alignParentTop="true"
          android:contentDescription="@null" />

      <TextView
          android:id="@+id/title"
          style="?titleTextAppearance"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_below="@id/icon" />

      <TextView
          android:id="@+id/subtitle"
          style="?subTitleTextAppearance"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_below="@id/title" />

      <TextView
          android:id="@+id/description"
          style="?descriptionTextAppearance"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_below="@id/subtitle" />

      <LinearLayout
          android:id="@+id/customized_view_container"
          android:orientation="vertical"
          android:gravity="center_vertical"
          android:layout_below="@id/subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
    </RelativeLayout>

  </ScrollView>

  <LinearLayout
      android:id="@+id/auth_credential_input"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:paddingBottom="24dp"
      android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/cube_auth_pin_dots_height">

      <!-- The real PIN field (ids/behaviour unchanged); invisible, the dots are drawn over it. -->
      <ImeAwareEditText
          android:id="@+id/lockPassword"
          style="@style/CubeAuthPinEntry"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:imeOptions="actionNext|flagNoFullscreen|flagForceAscii"
          android:inputType="numberPassword" />

      <com.android.systemui.biometrics.ui.CubePinDotsView
          android:id="@+id/cube_pin_dots"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/error"
        style="?errorTextAppearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minHeight="20dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="16dp" />

    <com.android.systemui.biometrics.ui.CubePinPadView
        android:id="@+id/pin_pad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.android.keyguard.NumPadKey
            android:id="@+id/key1"
            style="@style/NumPadKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            app:digit="1" />

        <com.android.keyguard.NumPadKey
            android:id="@+id/key2"
            style="@style/NumPadKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            app:digit="2" />

        <com.android.keyguard.NumPadKey
            android:id="@+id/key3"
            style="@style/NumPadKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            app:digit="3" />

        <com.android.keyguard.NumPadKey
            android:id="@+id/key4"
            style="@style/NumPadKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            app:digit="4" />

        <com.android.keyguard.NumPadKey
            android:id="@+id/key5"
            style="@style/NumPadKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            app:digit="5" />

        <com.android.keyguard.NumPadKey
            android:id="@+id/key6"
            style="@style/NumPadKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            app:digit="6" />

        <com.android.keyguard.NumPadKey
            android:id="@+id/key7"
            style="@style/NumPadKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            app:digit="7" />

        <com.android.keyguard.NumPadKey
            android:id="@+id/key8"
            style="@style/NumPadKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            app:digit="8" />

        <com.android.keyguard.NumPadKey
            android:id="@+id/key9"
            style="@style/NumPadKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            app:digit="9" />

        <TextView
            android:id="@+id/key_enter"
            style="@style/CubeAuthPinOkKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            android:contentDescription="@string/keyboardview_keycode_enter"
            android:visibility="invisible" />

        <com.android.keyguard.NumPadKey
            android:id="@+id/key0"
            style="@style/NumPadKey"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            app:digit="0" />

        <com.android.keyguard.NumPadButton
            android:id="@+id/delete_button"
            style="@style/NumPadKey.Delete"
            android:layout_width="@dimen/cube_auth_pin_key_size"
            android:layout_height="@dimen/cube_auth_pin_key_size"
            android:contentDescription="@string/keyboardview_keycode_delete"
            android:visibility="invisible" />
    </com.android.systemui.biometrics.ui.CubePinPadView>

    <Button
        android:id="@+id/emergencyCallButton"
        style="@style/AuthNonBioCredentialEmergencyButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:text="@string/work_challenge_emergency_button_text" />
  </LinearLayout>

</merge>
