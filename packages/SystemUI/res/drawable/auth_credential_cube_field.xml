<?xml version="1.0" encoding="utf-8"?>
<!-- CubeOS: the passcode field when an app asks you to confirm it's you - a soft rounded fill. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="0dp" android:insetBottom="0dp">
    <shape android:shape="rectangle">
        <solid android:color="#26808080" />
        <corners android:radius="14dp" />
        <padding android:left="16dp" android:right="16dp" android:top="12dp" android:bottom="12dp" />
    </shape>
</inset>
